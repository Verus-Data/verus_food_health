generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  foodEntries    FoodEntry[]
  healthOutcomes HealthOutcome[]
  personalTriggers PersonalTrigger[]
  dailyTrends    DailyTrend[]
}

model FoodEntry {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp            DateTime
  photoUrl             String?
  description          String?
  estimatedCalories    Int?
  confidence           Float?
  aiConfidence         Float?
  ingredientsConfirmed Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  ingredients          Ingredient[]
  healthOutcomes       HealthOutcome[]
}

model Ingredient {
  id          String     @id @default(cuid())
  name        String
  source      String     @default("manual")
  foodEntryId String
  foodEntry   FoodEntry  @relation(fields: [foodEntryId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model HealthOutcome {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodEntryId  String?
  foodEntry    FoodEntry? @relation(fields: [foodEntryId], references: [id], onDelete: SetNull)
  timestamp    DateTime
  type         String
  severity     Int
  notes        String?
  bristolScale Int?
  color        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PersonalTrigger {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient    String
  pValue        Float
  effectSize    Float
  sampleSize    Int
  confidence    String
  avgSeverityWith    Float
  avgSeverityWithout Float
  countWith     Int
  countWithout  Int
  lastAnalyzed  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, ingredient])
}

model DailyTrend {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  avgBmSeverity  Float?
  avgEnergy      Float?
  topSymptom     String?
  triggerCount   Int      @default(0)
  foodCount      Int      @default(0)
  outcomeCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
}